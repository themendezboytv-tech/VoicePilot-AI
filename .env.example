# ==========================================
# CONFIGURACIÓN DE MARCA BLANCA (WHITE-LABEL)
# ==========================================
# Aquí definimos el nombre comercial del SaaS. 
# Si mañana quieres llamarlo "AutoHost AI", solo cambias esta línea.
APP_NAME="Proyecto Alpha SaaS"
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
# Usaremos PostgreSQL porque es el estándar de oro para aplicaciones SaaS
# por su robustez, seguridad relacional y manejo concurrente.
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=voicepilot_db
DB_USERNAME=admin
DB_PASSWORD=secret_password

# ==========================================
# CACHÉ Y ESTADO EN TIEMPO REAL (Redis)
# ==========================================
# Redis guarda datos en la memoria RAM, no en el disco duro. 
# Lo usaremos para guardar el contexto de la llamada telefónica en milisegundos.
REDIS_HOST=localhost
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# PROVEEDORES DE TELEFONÍA (Gateway)
# ==========================================
# Credenciales para conectar los números de teléfono reales (ej. Twilio o Vonage).
TELEPHONY_PROVIDER=twilio
TELEPHONY_ACCOUNT_SID=tu_account_sid_aqui
TELEPHONY_AUTH_TOKEN=tu_auth_token_aqui
TELEPHONY_WEBHOOK_SECRET=tu_webhook_secret_aqui

# ==========================================
# MOTOR DE INTELIGENCIA ARTIFICIAL
# ==========================================
# Claves para conectar con los modelos de lenguaje (LLM).
AI_PROVIDER=openai
AI_API_KEY=tu_api_key_de_openai_aqui
AI_MODEL_DEFAULT=gpt-4-turbo

# El provider de IA se elige por Assistant (campo ai_provider en la tabla
# assistants), no por variable de entorno global. Las claves reales que lee
# el código de cada provider son estas:
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
OPENAI_API_KEY=tu_api_key_de_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# AUTENTICACIÓN DEL PANEL DE CLIENTE
# ==========================================
# Secreto para firmar los JWT de acceso emitidos por /api/auth/login. Debe
# ser un valor random largo (32+ bytes) y distinto entre dev/prod. Generarlo
# con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tu_secreto_random_largo_aqui

# ==========================================
# AUTENTICACIÓN DE VOICEPILOT ADMIN (superadministradores)
# ==========================================
# Secreto DISTINTO al JWT_SECRET de arriba — a propósito, para que un token
# de cliente nunca pueda verificarse contra el middleware de admin (ver
# backend/docs/design-voicepilot-admin.md). Mismo formato de generación.
ADMIN_JWT_SECRET=otro_secreto_random_largo_distinto_aqui