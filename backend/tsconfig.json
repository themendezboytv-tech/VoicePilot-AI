{
  "compilerOptions": {
    /* Opciones Principales de Compilación */
    "target": "ES2022",                  /* Versión moderna de JavaScript de salida */
    "module": "commonjs",                /* Sistema de módulos compatible con Node.js */
    "moduleResolution": "node",          /* Estrategia de resolución de paquetes */
    "rootDir": "./src",                  /* Ubicación de nuestro código fuente en TypeScript */
    "outDir": "./dist",                  /* Ubicación donde se guardará el JavaScript compilado */

    /* Reglas Estrictas de Calidad (Nivel Senior) */
    "strict": true,                      /* Activa la verificación estricta de tipos */
    "noImplicitAny": true,               /* Prohíbe el uso implícito del tipo 'any' */
    "strictNullChecks": true,            /* Evita errores de variables nulas o no definidas */

    /* Compatibilidad y Optimización */
    "esModuleInterop": true,             /* Permite importar bibliotecas CommonJS con sintaxis ES6 */
    "skipLibCheck": true,                /* Omite verificación de tipos en librerías externas para acelerar */
    "forceConsistentCasingInFileNames": true /* Obliga a mantener coherencia de mayúsculas/minúsculas en archivos */
  },
  "include": ["src/**/*"]                 /* Indica a TypeScript que analice todo lo dentro de la carpeta 'src' */
}